# Swara Environment Configuration
# Add your Google Drive links or folder IDs for each dataset class below:

# 1. Swara ("Hello Swara" Wake Word Dataset)
GOOGLE_DRIVE_LINK="https://drive.google.com/drive/folders/YOUR_SWARA_FOLDER_ID_HERE"
# Alternative accepted variable names:
# SWARA_DRIVE_LINK=
# GDRIVE_DATASET_URL=
# GDRIVE_FOLDER_ID=

# 2. Silence (Ambient background noise, room tone, quiet environments)
SILENCE_DRIVE_LINK="https://drive.google.com/drive/folders/YOUR_SILENCE_FOLDER_ID_HERE"
# Alternative accepted variable names:
# GOOGLE_DRIVE_SILENCE_LINK=
# GDRIVE_SILENCE_URL=

# 3. Unknown (Negative speech words, phonemes, background speech)
UNKNOWN_DRIVE_LINK="https://drive.google.com/drive/folders/YOUR_UNKNOWN_FOLDER_ID_HERE"
# Alternative accepted variable names:
# GOOGLE_DRIVE_UNKNOWN_LINK=
# GDRIVE_UNKNOWN_URL=
