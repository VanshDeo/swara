# ==============================================================================
# Swara Project .gitignore
# Ultra-low-power Edge Voice & Wake Detection Runtime
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Audio Data & Test Artifacts
# ------------------------------------------------------------------------------
# Ignore raw audio datasets but preserve directory structure
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep

# Audio binary formats
*.wav
*.pcm
*.raw
*.mp3
*.flac
*.ogg

# Ephemeral test artifacts generated during unit test runs
/test_*.wav
test_*.wav

# Preserve deterministic test audio fixtures
!tests/data/
!tests/data/**
!tests/data/*.wav

# ------------------------------------------------------------------------------
# 2. Model Checkpoints & Binaries
# ------------------------------------------------------------------------------
# Preserve models directory structure while ignoring large binary weights
models/**
!models/**/
!models/**/README.md
!models/**/.gitkeep

*.tflite
*.h5
*.hdf5
*.pb
*.ckpt*
*.savedmodel/
*.onnx

# ------------------------------------------------------------------------------
# 3. Build Artifacts & CMake / CTest Output
# ------------------------------------------------------------------------------
build/
bin/
out/
dist/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
*.ninja_deps
*.ninja_log
compile_commands.json
CTestTestfile.cmake
Testing/

# ------------------------------------------------------------------------------
# 4. Compiled Binaries, Objects & Libraries
# ------------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.elf
*.bin
*.hex
*.pdb
*.idb
*.ilk

# ------------------------------------------------------------------------------
# 5. Python Artifacts & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Operating System Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
# ------------------------------------------------------------------------------
# 7. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
._*
